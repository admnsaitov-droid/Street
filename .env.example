# Copy to `.env` and fill in. Full reference:
# obsidian/architecture/environment-variables.md

# --- Strapi (server-only) ---------------------------------------------------
API_URL=https://admin.streetbarbell.com
# Shared secret for POST /api/revalidate (Strapi publish webhook, header
# `x-revalidate-secret`). Unset = on-demand revalidation disabled; content then
# refreshes on the 5-minute cache TTL. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Public (baked into the browser bundle) ---------------------------------
NEXT_PUBLIC_IMAGE_URL=https://admin.streetbarbell.com
# Most of the code reads NEXT_PUBLIC_BASEURL (no underscore); set both until
# that drift is fixed — see environment-variables.md.
NEXT_PUBLIC_BASEURL=https://www.streetbarbell.com
NEXT_PUBLIC_BASE_URL=https://www.streetbarbell.com
NEXT_PUBLIC_LOCALES=en,es,fr,de,fi
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GTM_ID=
# Where the error pages' "Report this" button sends people (ADR-0112).
NEXT_PUBLIC_SUPPORT_EMAIL=
LOCALES=en,es,fr,de,fi

# --- Forms (server-only) ----------------------------------------------------
RESEND_API_KEY=
RECIPIENT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
